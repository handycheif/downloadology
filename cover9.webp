con\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"link\":{\"id\":\"236da6b9-99bb-4c08-b308-8bb2e2b46139\",\"url\":\"\",\"story\":{\"id\":514421153,\"url\":\"customer-stories/goodbuygear\",\"name\":\"How GoodBuy Gear increased conversions by 23% with consistent product photos\",\"slug\":\"goodbuygear\",\"uuid\":\"236da6b9-99bb-4c08-b308-8bb2e2b46139\",\"full_slug\":\"customer-stories/goodbuygear\",\"_stopResolving\":true},\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"customer-stories/goodbuygear\",\"href\":\"/customer-stories/goodbuygear\"},\"label\":\"Read story\",\"density\":\"\",\"variant\":\"\",\"component\":\"WorkflowButton\"}],\"_uid\":\"c98fd808-a910-440c-a100-ae982a251bd4\",\"logo\":{\"id\":18571350,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/191576/240x80/74e3572cce/source_goodbuy_gear.webp\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{},\"is_external_url\":false},\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\\"Photoroom changed everything for us. It automated the background editing, making every photo consistent. This has considerably streamlined our process, giving us the freedom to innovate and improve the speed at which products are made available online.\\\"\",\"type\":\"text\"}]}]},\"component\":\"CustomerStoryCard\",\"authorName\":\"Audra Jones\",\"badgeLabel\":\"Customer story\",\"visualLarge\":{\"id\":17542996,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/191576/1200x960/aa22e1c6fe/source_goodbuy_gear.webp\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{},\"is_external_url\":false},\"visualSmall\":{\"id\":17543016,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":