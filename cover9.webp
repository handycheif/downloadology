east.webp\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{},\"is_external_url\":false},\"visualSmall\":{\"id\":17543079,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/191576/1176x448/e3fb1fdd54/source_pam_east.webp\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{},\"is_external_url\":false},\"authorJobTitle\":\"Founder, Pam East Designs\",\"cssBackgroundColor\":\"#E5F9FF\"},{\"cta\":[{\"_uid\":\"446b022a-0beb-4fdc-80d0-14a55011001b\",\"icon\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"link\":{\"id\":\"589afef3-c68f-4cac-9112-b95c9ff7d2b2\",\"url\":\"\",\"story\":{\"id\":503960904,\"url\":\"customer-stories/1994-candle-co\",\"name\":\"How The 1994 Candle Co. uses Photoroom to create social content and sell more\",\"slug\":\"1994-candle-co\",\"uuid\":\"589afef3-c68f-4cac-9112-b95c9ff7d2b2\",\"full_slug\":\"customer-stories/1994-candle-co\",\"_stopResolving\":true},\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"customer-stories/1994-candle-co\",\"href\":\"/customer-stories/1994-candle-co\"},\"label\":\"Read story\",\"density\":\"\",\"variant\":\"\",\"component\":\"WorkflowButton\"}],\"_uid\":\"7d7cebf1-b487-4d69-bb06-126c986706b3\",\"logo\":{\"id\":17542974,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/191576/144x176/78351541ab/source_nick_hawkins.webp\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{},\"is_external_url\":false},\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"“I’m really skeptical when it comes to AI photography and photo editing because I am a photographer, but Photoroom’s AI Backgrounds always looks great and realistic.”\",\"type\":\"text\"}]}]},\"component\":\"CustomerStoryCard\",\"authorName\":\"